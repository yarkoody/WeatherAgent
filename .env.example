# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Model used by the agent (picked at build time from models your key can access)
OPENAI_MODEL=
# Optional: webhook for score-change alerts (bonus). Empty = write to logs/alerts.jsonl
ALERT_WEBHOOK_URL=
# Optional: TypeSafe key for the offline JEV cross-check (evals/jev_crosscheck.py)
TYPESAFE_API_KEY=
# Public deployment protection
RATE_LIMIT_PER_MIN=10
DAILY_REQUEST_CAP=300
# Token required by POST /alerts/check
ALERT_TOKEN=

# Copy to .env and fill in. Never commit .env.
OPENAI_API_KEY=
# Model used by the agent (picked at build time from models your key can access)
OPENAI_MODEL=
# Optional: webhook for score-change alerts (bonus). Empty = write to logs/alerts.jsonl
ALERT_WEBHOOK_URL=
# Optional: TypeSafe key for the offline JEV cross-check (evals/jev_crosscheck.py)
TYPESAFE_API_KEY=
# Public deployment protection
RATE_LIMIT_PER_MIN=10
DAILY_REQUEST_CAP=300
# Token required by POST /alerts/check
ALERT_TOKEN=
# Header with the real client IP set by the edge proxy (Render: cf-connecting-ip). Empty = use X-Forwarded-For.
CLIENT_IP_HEADER=
# Number of trusted proxies appending to X-Forwarded-For (used when CLIENT_IP_HEADER is empty)
TRUSTED_PROXY_HOPS=1
# Reasoning effort sent to the model (default low)
OPENAI_REASONING_EFFORT=
# Developer-only: allow POST /second-opinion/rerun on this machine (needs TYPESAFE_API_KEY)
JEV_RERUN_ENABLED=

data: {"data": {"session_id": "mock-ranking", "answer": {"answer": "**Minneapolis Hub** has the highest winter exposure among Midwest hubs (92.1), followed by **Chicago Hub** (43.6) and **Detroit Hub** (39.4). Its overall investment priority is 66.7 (high).", "hubs": ["minneapolis", "chicago", "detroit"], "ranking": ["minneapolis", "chicago", "detroit"], "figures": [{"hub_id": "minneapolis", "label": "winter exposure score", "value": 92.1, "unit": "score 0-100", "source_tool": "rank_hubs"}, {"hub_id": "chicago", "label": "winter exposure score", "value": 43.6, "unit": "score 0-100", "source_tool": "rank_hubs"}, {"hub_id": "detroit", "label": "winter exposure score", "value": 39.4, "unit": "score 0-100", "source_tool": "rank_hubs"}, {"hub_id": "minneapolis", "label": "investment priority", "value": 66.7, "unit": "score 0-100", "source_tool": "get_hub_risk"}], "assumptions": ["Midwest follows US Census regions.", "Winter exposure blends FEMA event frequency and observed snow and freezing days."], "uncertainty": "Scores use the committed snapshot (FEMA NRI and Open-Meteo 2015-2025).", "data_available": true, "in_scope": true}, "grounding": {"status": "pass", "errors": []}, "trace_id": "cfea9c27d21d4752b70b5dcf69b88a00", "follow_ups": ["Why is Minneapolis ranked first?", "Compare Minneapolis and Chicago", "Show the bad-year ranking"]}, "type": "data-answer"}

